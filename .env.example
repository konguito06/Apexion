# Optional: some current FastF1 live-timing requests may require an F1 account.
# Keep real credentials in your local, untracked .env file.
F1_USERNAME=
F1_PASSWORD=
APEXION_CORS_ORIGINS=
# Set to the exact browser origin only when the frontend calls a separately hosted API.
# APEXION_CORS_ORIGINS=https://apexion.example.com
# Leave empty for Docker Compose, which proxies /api through the frontend origin.
VITE_API_URL=
